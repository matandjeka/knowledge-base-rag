APP_NAME=Enterprise Knowledge Fusion RAG
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
DATA_DIR=data
METADATA_STORE_BACKEND=memory
SOURCE_STORAGE_BACKEND=local
LEXICAL_STORE_BACKEND=local
GRAPH_STORE_BACKEND=local
# Production persistence (Phase 16)
# METADATA_DATABASE_URL=postgresql+asyncpg://app:replace-me@postgres.example.com:5432/rag
METADATA_DATABASE_SCHEMA=rag
METADATA_POOL_SIZE=10
METADATA_POOL_TIMEOUT_SECONDS=30
# AZURE_BLOB_ACCOUNT_URL=https://account.blob.core.windows.net
# AZURE_BLOB_CONTAINER=knowledge-sources
# Development alternative only; prefer managed identity in production:
# AZURE_STORAGE_CONNECTION_STRING=
LEXICAL_CACHE_MAX_GENERATIONS=8
# NEO4J_URI=neo4j+s://cluster.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
MAX_PDF_SIZE_BYTES=26214400
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
WEBSITE_MAX_PAGES=20
WEBSITE_MAX_RESPONSE_BYTES=5242880
WEBSITE_REQUEST_TIMEOUT_SECONDS=10
WEBSITE_MAX_REDIRECTS=5
WEBSITE_CRAWL_DELAY_SECONDS=0.25
WEBSITE_USER_AGENT=EnterpriseKnowledgeFusionRAG/0.1
WEBSITE_CHUNK_SIZE=1200
WEBSITE_CHUNK_OVERLAP=200
MAX_CSV_SIZE_BYTES=26214400
CSV_MAX_ROWS=100000
CSV_MAX_COLUMNS=200
CSV_MAX_FIELD_CHARACTERS=100000
CSV_PREVIEW_ROWS=10
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_MIN_SIMILARITY=0.70
SENTENCE_WINDOW_RADIUS=2
BM25_K1=1.5
BM25_B=0.75
LEXICAL_TITLE_BOOST=0.5
LEXICAL_MIN_SCORE=0.0
FUSION_RRF_K=60
FUSION_CANDIDATE_MULTIPLIER=3
FUSION_VECTOR_WEIGHT=0.40
FUSION_SENTENCE_WINDOW_WEIGHT=0.25
FUSION_GRAPH_WEIGHT=0.25
FUSION_LEXICAL_WEIGHT=0.10
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=auto
RERANKING_CANDIDATE_POOL_SIZE=30
RERANKING_MAX_PER_SOURCE=2
VECTOR_STORE_BACKEND=faiss
# Required only when VECTOR_STORE_BACKEND=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_INDEX_HOST=
PINECONE_TIMEOUT_SECONDS=30
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_CONSISTENCY_RETRIES=5
PINECONE_CONSISTENCY_DELAY_SECONDS=0.25
# Required only when explicitly rebuilding the knowledge graph
# OPENAI_API_KEY=
# GRAPH_EXTRACTION_MODEL=
GRAPH_EXTRACTION_TIMEOUT_SECONDS=60
GRAPH_EXTRACTION_MAX_RETRIES=2
GRAPH_EXTRACTION_BATCH_SIZE=8
GRAPH_EXTRACTION_MAX_BATCH_CHARACTERS=20000
GRAPH_RETRIEVAL_MAX_HOPS=2
# Required only for retrieval_mode=sql
# SQL_GENERATION_MODEL=gpt-5-mini
SQL_GENERATION_TIMEOUT_SECONDS=30
SQL_GENERATION_MAX_RETRIES=2
SQL_EXECUTION_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=100
ROUTING_CONFIDENCE_THRESHOLD=0.70
ROUTING_WINNING_MARGIN=0.15
# Database sources reference environment variables containing URLs, for example:
SALES_DATABASE_URL=postgresql://readonly_user:replace-me@database.example.com:5432/app
